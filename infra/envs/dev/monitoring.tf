# --- Monitoring: Prometheus + Grafana, with Aurora MySQL metrics from two angles ---
#
#   kube-prometheus-stack   Prometheus (collects and stores metrics), Grafana (dashboards),
#                           Alertmanager (alerts), plus node and Kubernetes exporters.
#   YACE                    "Yet Another CloudWatch Exporter": reads AWS's own RDS metrics
#                           (ACUs, CPU, latency, replica lag) from CloudWatch. The outside view.
#   mysqld_exporter         Logs in to MySQL and reads its internal counters (queries, buffer
#                           pool, temp tables, lock waits). The inside view.
#
# Prometheus *pulls*: every 30-60s it scrapes each exporter's /metrics page. Exporters are found
# through ServiceMonitor objects, so adding a new target is a label, not a config file edit.

locals {
  monitoring_namespace = "monitoring"
  chart_repo           = "https://prometheus-community.github.io/helm-charts"

  # CloudWatch metrics YACE should fetch for every RDS resource tagged project = golf-booking.
  rds_metrics = {
    ServerlessDatabaseCapacity = ["Maximum"] # current ACUs
    ACUUtilization             = ["Average"] # % of max_capacity
    CPUUtilization             = ["Average"]
    FreeableMemory             = ["Minimum"]
    DatabaseConnections        = ["Maximum"]
    DMLLatency                 = ["Average"]
    SelectLatency              = ["Average"]
    CommitLatency              = ["Average"]
    AuroraReplicaLag           = ["Maximum"]
  }
}

# --- Passwords: generated by Terraform, kept in state (encrypted in S3), never in code ---

resource "random_password" "grafana_admin" {
  length  = 24
  special = false
}

# You create the matching MySQL user once, by hand (see README "Monitoring").
resource "random_password" "mysql_exporter" {
  length  = 24
  special = false
}

# --- 1. Prometheus, Grafana, Alertmanager ---

resource "helm_release" "kube_prometheus_stack" {
  name             = "kube-prometheus-stack"
  repository       = local.chart_repo
  chart            = "kube-prometheus-stack"
  version          = "93.4.1"
  namespace        = local.monitoring_namespace
  create_namespace = true
  timeout          = 900 # first install pulls a dozen images

  values = [yamlencode({
    # EKS runs these control-plane parts for us and doesn't expose them, so don't scrape them.
    kubeControllerManager = { enabled = false }
    kubeScheduler         = { enabled = false }
    kubeEtcd              = { enabled = false }
    kubeProxy             = { enabled = false }

    prometheus = {
      prometheusSpec = {
        retention = "2d" # dev cluster is destroyed nightly anyway; no persistent volume
        resources = { requests = { cpu = "200m", memory = "512Mi" } }
        # Pick up every ServiceMonitor/PodMonitor/PrometheusRule in the cluster, not only ones
        # labelled for this release. That's what lets other charts plug themselves in.
        serviceMonitorSelectorNilUsesHelmValues = false
        podMonitorSelectorNilUsesHelmValues     = false
        ruleSelectorNilUsesHelmValues           = false
      }
    }

    alertmanager = {
      alertmanagerSpec = { resources = { requests = { cpu = "10m", memory = "64Mi" } } }
    }

    grafana = {
      adminPassword = random_password.grafana_admin.result
      persistence   = { enabled = false }
      # Load our Aurora dashboard from a file in this folder.
      dashboardProviders = {
        "dashboardproviders.yaml" = {
          apiVersion = 1
          providers = [{
            name    = "golf"
            folder  = "Golf booking"
            type    = "file"
            options = { path = "/var/lib/grafana/dashboards/golf" }
          }]
        }
      }
      dashboards = {
        golf = {
          aurora-mysql = { json = file("${path.module}/dashboards/aurora-mysql.json") }
        }
      }
    }

    # Alert rules live next to the metrics they watch. Alertmanager has no receiver configured,
    # so alerts show in its UI (and Grafana) without paging anyone.
    additionalPrometheusRulesMap = {
      aurora-mysql = {
        groups = [{
          name = "aurora-mysql"
          rules = [
            {
              alert       = "AuroraNearMaxCapacity"
              expr        = "aws_rds_acuutilization_average > 90"
              for         = "10m"
              labels      = { severity = "warning" }
              annotations = { summary = "{{ $labels.dimension_DBInstanceIdentifier }} has been above 90% of max ACUs for 10 minutes: raise max_capacity or find the query." }
            },
            {
              alert       = "MySQLExporterDown"
              expr        = "mysql_up == 0"
              for         = "5m"
              labels      = { severity = "warning" }
              annotations = { summary = "mysqld_exporter can't log in to Aurora MySQL (paused cluster, wrong password, or exporter user missing)." }
            },
            {
              alert       = "AuroraReplicaLagHigh"
              expr        = "aws_rds_aurora_replica_lag_maximum > 1000"
              for         = "5m"
              labels      = { severity = "warning" }
              annotations = { summary = "A reader is more than 1s behind the writer." }
            },
          ]
        }]
      }
    }
  })]

  # The chart installs its CRDs (ServiceMonitor etc.) and the operator that watches them.
  depends_on = [module.eks]
}

# --- 2. YACE: CloudWatch metrics, with AWS access through EKS Pod Identity ---
# Pod Identity maps a Kubernetes service account to an IAM role. The pod gets temporary AWS
# credentials automatically: no access keys in a Secret, nothing to rotate.

data "aws_iam_policy_document" "yace_trust" {
  statement {
    actions = ["sts:AssumeRole", "sts:TagSession"]
    principals {
      type        = "Service"
      identifiers = ["pods.eks.amazonaws.com"]
    }
  }
}

resource "aws_iam_role" "yace" {
  name               = "${local.name}-yace"
  assume_role_policy = data.aws_iam_policy_document.yace_trust.json
}

# Read-only: list and read CloudWatch metrics, and find resources by tag.
data "aws_iam_policy_document" "yace" {
  statement {
    actions   = ["cloudwatch:GetMetricData", "cloudwatch:ListMetrics", "tag:GetResources"]
    resources = ["*"] # these APIs don't support resource-level restrictions
  }
}

resource "aws_iam_role_policy" "yace" {
  name   = "read-cloudwatch"
  role   = aws_iam_role.yace.id
  policy = data.aws_iam_policy_document.yace.json
}

resource "aws_eks_pod_identity_association" "yace" {
  cluster_name    = module.eks.cluster_name
  namespace       = local.monitoring_namespace
  service_account = "yace"
  role_arn        = aws_iam_role.yace.arn
}

resource "helm_release" "yace" {
  name       = "yace"
  repository = local.chart_repo
  chart      = "prometheus-yet-another-cloudwatch-exporter"
  version    = "0.50.0"
  namespace  = local.monitoring_namespace

  values = [yamlencode({
    serviceAccount = { create = true, name = aws_eks_pod_identity_association.yace.service_account }
    serviceMonitor = { enabled = true, interval = "60s" }
    resources      = { requests = { cpu = "10m", memory = "64Mi" } }
    # YACE's own config, generated from local.rds_metrics. CloudWatch charges per metric
    # requested, so this list is also the cost: a few cents a day at this size.
    config = yamlencode({
      apiVersion = "v1alpha1"
      sts-region = var.region
      discovery = {
        jobs = [{
          type       = "AWS/RDS"
          regions    = [var.region]
          searchTags = [{ key = "project", value = var.project }]
          metrics = [for name, stats in local.rds_metrics : {
            name       = name
            statistics = stats
            period     = 60
            length     = 300
          }]
        }]
      }
    })
  })]

  depends_on = [helm_release.kube_prometheus_stack] # needs the ServiceMonitor CRD
}

# --- 3. mysqld_exporter: MySQL's own counters ---
# Connects to the writer endpoint, so after a failover it follows the new writer.
# Side effect worth knowing: scraping every 30s keeps a connection active, so the cluster
# no longer auto-pauses at 0 ACUs while this runs (about 0.5 ACU, roughly $0.07/hour).

resource "helm_release" "mysql_exporter" {
  count = var.enable_mysql_exporter ? 1 : 0

  name       = "mysql-exporter"
  repository = local.chart_repo
  chart      = "prometheus-mysql-exporter"
  version    = "2.17.1"
  namespace  = local.monitoring_namespace

  values = [yamlencode({
    serviceMonitor = { enabled = true }
    resources      = { requests = { cpu = "10m", memory = "32Mi" } }
    mysql = {
      host = aws_rds_cluster.mysql.endpoint
      port = 3306
      user = "exporter"
    }
  })]

  # set_sensitive keeps the password out of plan output.
  set_sensitive = [{
    name  = "mysql.pass"
    value = random_password.mysql_exporter.result
  }]

  depends_on = [helm_release.kube_prometheus_stack]
}
